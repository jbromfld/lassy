# Copy to .env and fill in the PostgreSQL credentials.
# Environment variables override .env. Restart the API after changing settings.

# Logging
LOG_LEVEL=INFO

# API_PORT controls python -m api.main and the Compose host port.
# DEBUG enables reload only with python -m api.main.
# Explicit uvicorn command-line flags control its port and reload behavior.
API_PORT=8000
DEBUG=false

# External PostgreSQL connection
# Use host.docker.internal when the API runs in Docker against a host database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=<YOUR_DB_NAME>
POSTGRES_USER=<YOUR_DB_USER>
POSTGRES_PASSWORD=<YOUR_DB_PASSWORD>
DB_POOL_SIZE=10

# Embeddings
# Both dimensions must match the model output and db/init.sql vector dimension.
# Index type and HNSW tuning are defined in db/init.sql, not environment settings.
PGVECTOR_DIMENSION=768
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
# Optional immutable Hugging Face commit; prepare its snapshot before offline use.
# LOCAL_EMBEDDING_REVISION=e8c3b32edf5434bc2275fc9bab85f82640a19130
LOCAL_EMBEDDING_DIMENSION=768
LOCAL_EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_DEVICE=cpu

# Compose bind-mount source on the Docker host (relative to this repository).
# Create this directory before starting Docker. It must be writable by UID 1000.
MODEL_CACHE_DIR=./.cache/huggingface
# Set to 1 after warming the cache to skip Hugging Face network checks.
# Leave 0 for first-run downloads; see README for warming/update/purge commands.
HF_HUB_OFFLINE=0

# Document chunking (word counts)
CHUNK_STRATEGY=recursive
CHUNK_SIZE=300
CHUNK_OVERLAP=30
MIN_CHUNK_SIZE=50
MAX_CHUNK_SIZE=500

# Retrieval: requests can override top_k and supply metadata filters.
# Hybrid search uses reciprocal rank fusion with fixed equal contributions.
RETRIEVAL_TOP_K=5
HYBRID_SEARCH_ENABLED=true
# This threshold is applied only when HYBRID_SEARCH_ENABLED=false.
RELEVANCE_THRESHOLD=0.7

# Optional local cross-encoder reranking
ENABLE_RERANKING=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_REVISION=YOUR_PINNED_HUGGING_FACE_COMMIT
RERANK_TOP_K=10

# Metadata ranking boosts; thresholds currently use built-in constants.
# Feedback support is still part of the current service/schema.
RECENCY_BOOST_ENABLED=true
QUALITY_BOOST_ENABLED=true
POPULARITY_BOOST_ENABLED=true
