# ============================================
# RAG Service - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# ============================================
# Application
# ============================================
APP_NAME=rag-service
ENVIRONMENT=docker  # local or docker
LOG_LEVEL=DEBUG
API_PORT=8000
DEBUG=false

# ============================================
# PostgreSQL
# ============================================
# Runtime connection from the API container
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=rag_service
POSTGRES_USER=
POSTGRES_PASSWORD=

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Vector Store / Embeddings
# ============================================
PGVECTOR_DIMENSION=768
PGVECTOR_INDEX_TYPE=hnsw
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64

LOCAL_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
LOCAL_EMBEDDING_DIMENSION=768
LOCAL_EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_DEVICE=cpu

# ============================================
# Copilot LLM
# ============================================
COPILOT_API_KEY=
COPILOT_TEMPERATURE=0.7
COPILOT_MAX_TOKENS=2000

# ============================================
# Chunking
# ============================================
CHUNK_STRATEGY=recursive
CHUNK_SIZE=300
CHUNK_OVERLAP=30
MIN_CHUNK_SIZE=50
MAX_CHUNK_SIZE=500

# ============================================
# Retrieval
# ============================================
RETRIEVAL_TOP_K=5
HYBRID_SEARCH_ENABLED=true
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
RELEVANCE_THRESHOLD=0.7

ENABLE_RERANKING=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=10

ENABLE_QUERY_EXPANSION=false
EXPANSION_METHOD=synonym
MAX_EXPANSIONS=3

RECENCY_BOOST_ENABLED=true
RECENCY_VERY_RECENT_DAYS=30
RECENCY_RECENT_DAYS=90
RECENCY_MODERATE_DAYS=180
RECENCY_DECAY_RATE=730.0

QUALITY_BOOST_ENABLED=true
QUALITY_MIN_FEEDBACK=3
POPULARITY_BOOST_ENABLED=true

# ============================================
# Generation
# ============================================
PROMPT_TEMPLATE=default
PROMPT_VERSION=1.0
INCLUDE_SOURCES=true
MAX_CONTEXT_TOKENS=8000
RESPONSE_FORMAT=markdown
INCLUDE_CITATIONS=true
CITATION_FORMAT=inline

CONTENT_FILTER_ENABLED=true
PII_DETECTION_ENABLED=false
TOXIC_FILTER_ENABLED=false

# ============================================
# Ingestion / Monitoring
# ============================================
SCRAPE_MAX_DEPTH=3
SCRAPE_MAX_PAGES=100
SCRAPE_TIMEOUT_SECONDS=10
SCRAPE_USER_AGENT=RAG-Testing-Bot/1.0

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

LOG_QUERIES=true
LOG_RESPONSES=true
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_EXPORT_INTERVAL_SECONDS=60
