{
  "name": "kbsearch-extension",
  "displayName": "KB Search Mention",
  "description": "Adds an @knowledge chat participant for internal knowledge queries.",
  "version": "0.0.1",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "file:///Users/jbromfield/workspace/kbsearch-extension"
  },
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onChatParticipant:kbsearch-extension.knowledge"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "kbsearch-extension.knowledge",
        "name": "knowledge",
        "fullName": "Internal Knowledge",
        "description": "Ask questions using internal knowledge context.",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "KB Search",
      "properties": {
        "kbsearch.mcpUrl": {
          "type": "string",
          "default": "http://localhost:8080/mcp",
          "description": "MCP endpoint used by @knowledge."
        },
        "kbsearch.toolName": {
          "type": "string",
          "default": "search_knowledge_base",
          "description": "MCP tool name invoked by @knowledge."
        },
        "kbsearch.profile": {
          "type": "string",
          "default": "default",
          "description": "Profile argument passed to the MCP tool."
        },
        "kbsearch.topK": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Number of relevant chunks to retrieve."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "2.24.0",
    "@types/node": "^20.16.5",
    "@types/vscode": "^1.97.0",
    "typescript": "^5.6.2"
  }
}
