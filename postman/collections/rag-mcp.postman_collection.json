{
  "info": {
    "name": "RAG MCP API",
    "description": "Standalone ingestion, retrieval, feedback and metrics. Configure the service through .env; clients generate answers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Info",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Root endpoint \u2014 returns service name, version, and status."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Health check \u2014 returns service and database status."
          }
        }
      ]
    },
    {
      "name": "Ingestion",
      "item": [
        {
          "name": "Ingest URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/docs/page\",\n  \"depth\": 1,\n  \"max_pages\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/ingest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Ingest a document by URL. Scrapes, chunks, embeds, and stores in the vector database."
          }
        },
        {
          "name": "Ingest Content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Your document content here.\",\n  \"title\": \"My Document\",\n  \"metadata\": {\n    \"author\": \"team\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/ingest",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingest"
              ]
            },
            "description": "Ingest direct text content. Chunks, embeds, and stores in the vector database."
          }
        }
      ]
    },
    {
      "name": "Query",
      "item": [
        {
          "name": "Query (Retrieval)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is AKS?\",\n  \"top_k\": 5,\n  \"retrieve_only\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/query",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "query"
              ]
            },
            "description": "Returns ranked retrieval chunks with citations; clients generate answers. Optional local reranking is configured in the service environment."
          }
        },
        {
          "name": "Query (Retrieve Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is AKS?\",\n  \"top_k\": 5,\n  \"retrieve_only\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/query",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "query"
              ]
            },
            "description": "Returns ranked retrieval chunks with citations; clients generate answers. Optional local reranking is configured in the service environment."
          }
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"score\": 8,\n  \"comment\": \"Accurate and helpful answer.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/feedback",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "feedback"
              ]
            },
            "description": "Submit feedback for a query. Score 0-10 (7+ = satisfied)."
          }
        }
      ]
    }
  ]
}
