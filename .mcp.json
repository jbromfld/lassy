{
  "servers": {
    "lassy": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "lassy.mcp"
      ],
      "env": {
        "LASSY_ENV_FILE": "${workspaceFolder}/.env",
        "HF_HOME": "${workspaceFolder}/.cache/huggingface"
      }
    }
  }
}
